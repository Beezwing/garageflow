# ---------------------------------------------------------------------------
# GarageFlow environment
# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used for admin tasks (invites, seeding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used in emails / links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notification providers (optional — omitted => mock/no-op in dev)
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
